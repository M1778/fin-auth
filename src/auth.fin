// SPDX-License-Identifier: MIT
// Authentication & sessions for Fin (coordinated unreleased hardening).
//
// Primitives come from fin-crypto's raw HMAC API; strict JWT JSON parsing comes
// from finson. These APIs require the coordinated sibling source checkouts,
// not the old dependency tags in finn.toml. See README for build commands.
//
// crypt(3) stays in the opt-in auth_crypt::fin module, linked with -lcrypt.
// Tested with frozen finc 0.4.0 contract 3 at -O0 and -O2. Parallel collections
// retain the existing SessionStore ABI; string comparisons are content-based.

#[stdimport] %{
import { to_chars, from_chars, equals, concat, substr, find, len, starts_with, free_str } from strings::std;
import { now } from time::std;
import { Collection } from collection::std;
import { hmac_sha256_bytes, random_bytes, random_hex, const_time_eq } from crypto::fin;
import { json_parse, json_parse_strict, json_stringify, json_object_get, json_array_len, json_array_get, json_free_result, JsonValue, ParseResult } from finson::fin;
}%

namespace fin {

// --- private helpers ---

priv fun byte_at(b: [char], i: int) <uint> {
    let v <int> = cast<int>(b[i]);
    if (v < 0) { v = v + 256; }
    return cast<uint>(v);
}

// Byte buffer returned by value; the caller owns `data`.
#[export]
pub struct AuthBytes {
    pub:
        data <[char]>,
        len <int>,
}

#[export]
pub fun auth_free_bytes(b: &AuthBytes) <noret> {
    delete b.data;
}

// --- base64url over byte arrays (explicit length; see header note 1) ---

priv fun b64u_char(v: uint) <char> {
    if (v < cast<uint>(26)) { return cast<char>(cast<int>('A') + cast<int>(v)); }
    if (v < cast<uint>(52)) { return cast<char>(cast<int>('a') + cast<int>(v) - 26); }
    if (v < cast<uint>(62)) { return cast<char>(cast<int>('0') + cast<int>(v) - 52); }
    if (v == cast<uint>(62)) { return '-'; }
    return '_';
}

// base64url WITHOUT padding (RFC 4648 section 5, RFC 7515): the JWT encoding.
#[export]
pub fun auth_b64url_encode(data: [char], len: int) <string> {
    // Invalid caller bounds are recoverable; never read beyond the array.
    if (len < 0 || len > data.length || len > 12582912) { return concat("", ""); }
    let full <int> = len / 3;
    let rem <int> = len % 3;
    let out_len <int> = full * 4;
    if (rem == 1) { out_len = out_len + 2; }
    if (rem == 2) { out_len = out_len + 3; }
    let out <[char]> = new [char, out_len + 1]{};
    let o <int> = 0;
    for (let g <int> = 0; g < full; g++) {
        let i <int> = g * 3;
        let v <uint> = byte_at(data, i) * cast<uint>(65536)
                     + byte_at(data, i + 1) * cast<uint>(256)
                     + byte_at(data, i + 2);
        out[o] = b64u_char((v >> cast<uint>(18)) % cast<uint>(64));
        out[o + 1] = b64u_char((v >> cast<uint>(12)) % cast<uint>(64));
        out[o + 2] = b64u_char((v >> cast<uint>(6)) % cast<uint>(64));
        out[o + 3] = b64u_char(v % cast<uint>(64));
        o = o + 4;
    }
    if (rem > 0) {
        let i <int> = full * 3;
        let v <uint> = byte_at(data, i) * cast<uint>(65536);
        if (rem == 2) { v = v + byte_at(data, i + 1) * cast<uint>(256); }
        out[o] = b64u_char((v >> cast<uint>(18)) % cast<uint>(64));
        out[o + 1] = b64u_char((v >> cast<uint>(12)) % cast<uint>(64));
        if (rem == 2) { out[o + 2] = b64u_char((v >> cast<uint>(6)) % cast<uint>(64)); }
    }
    out[out_len] = cast<char>(0);
    let s <string> = from_chars(out, 0, out_len);
    delete out;
    return s;
}

priv fun b64u_val(c: char) <int> {
    if (c >= 'A' && c <= 'Z') { return cast<int>(c) - cast<int>('A'); }
    if (c >= 'a' && c <= 'z') { return cast<int>(c) - cast<int>('a') + 26; }
    if (c >= '0' && c <= '9') { return cast<int>(c) - cast<int>('0') + 52; }
    if (c == '-') { return 62; }
    if (c == '_') { return 63; }
    return -1;
}

// Strict unpadded base64url; caller frees data even when len == -1.
#[export]
pub fun auth_b64url_decode(s: string) <AuthBytes> {
    let n <int> = len(s);
    // Bound allocations and reject impossible encoded lengths before decoding.
    if (n > 16777216 || n % 4 == 1) {
        return AuthBytes{data: new [char, 1]{}, len: -1};
    }
    let chars <[char]> = to_chars(s);
    let valid <bool> = true;
    for (let i <int> = 0; i < n; i++) {
        if (b64u_val(chars[i]) < 0) { valid = false; }
    }
    if (n % 4 == 2 && b64u_val(chars[n - 1]) % 16 != 0) { valid = false; }
    if (n % 4 == 3 && b64u_val(chars[n - 1]) % 4 != 0) { valid = false; }
    if (!valid) {
        delete chars;
        return AuthBytes{data: new [char, 1]{}, len: -1};
    }
    let pad <int> = (4 - (n % 4)) % 4;
    let total <int> = n + pad;
    let out_len <int> = (total / 4) * 3 - pad;
    let out <[char]> = new [char, out_len + 1]{};
    let o <int> = 0;
    let ok <bool> = true;
    for (let i <int> = 0; i < total; i = i + 4) {
        let c0 <char> = cast<char>('A');
        let c1 <char> = cast<char>('A');
        let c2 <char> = cast<char>('A');
        let c3 <char> = cast<char>('A');
        if (i < n) { c0 = chars[i]; }
        if (i + 1 < n) { c1 = chars[i + 1]; }
        if (i + 2 < n) { c2 = chars[i + 2]; }
        if (i + 3 < n) { c3 = chars[i + 3]; }
        let v0 <int> = b64u_val(c0);
        let v1 <int> = b64u_val(c1);
        let v2 <int> = b64u_val(c2);
        let v3 <int> = b64u_val(c3);
        if (v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0) { ok = false; }
        let v <int> = v0 * 262144 + v1 * 4096 + v2 * 64 + v3;
        if (o < out_len) { out[o] = cast<char>(v / 65536); o = o + 1; }
        if (o < out_len) { out[o] = cast<char>((v / 256) % 256); o = o + 1; }
        if (o < out_len) { out[o] = cast<char>(v % 256); o = o + 1; }
    }
    delete chars;
    out[out_len] = cast<char>(0);
    if (!ok) {
        delete out;
        return AuthBytes{data: new [char, 1]{}, len: -1};
    }
    return AuthBytes{data: out, len: out_len};
}

// --- HMAC-SHA256 with raw byte output ---
// Requires the sibling fin-crypto raw-byte API (not its published v0.1.1).
priv fun hmac_raw(key: [char], key_len: int, msg: [char], msg_len: int) <[char]> {
    return hmac_sha256_bytes(key, key_len, msg, msg_len);
}

// --- PBKDF2-HMAC-SHA256 (RFC 8018) ---
// The supported password hash. Pure Fin over fin-crypto's HMAC; test vectors
// generated with Python hashlib.pbkdf2_hmac.

// iterations and dk_len are ints; dk_len <= 32 * blocks handled by truncation.
priv fun pbkdf2(password: [char], pw_len: int, salt: [char], salt_len: int, iterations: int, dk_len: int) <[char]> {
    blame iterations > 0, "pbkdf2: iterations must be positive";
    blame dk_len > 0, "pbkdf2: derived key length must be positive";
    let blocks <int> = (dk_len + 31) / 32;
    let dk <[char]> = new [char, dk_len + 1]{};
    for (let b <int> = 1; b <= blocks; b++) {
        // msg = salt || INT32_BE(b)
        let msg <[char]> = new [char, salt_len + 5]{};
        for (let i <int> = 0; i < salt_len; i++) { msg[i] = salt[i]; }
        msg[salt_len] = cast<char>((b >> 24) % 256);
        msg[salt_len + 1] = cast<char>((b >> 16) % 256);
        msg[salt_len + 2] = cast<char>((b >> 8) % 256);
        msg[salt_len + 3] = cast<char>(b % 256);
        msg[salt_len + 4] = cast<char>(0);
        let u <[char]> = hmac_raw(password, pw_len, msg, salt_len + 4);
        delete msg;
        let t <[char]> = new [char, 33]{};
        for (let i <int> = 0; i < 32; i++) { t[i] = u[i]; }
        t[32] = cast<char>(0);
        for (let r <int> = 1; r < iterations; r++) {
            let u2 <[char]> = hmac_raw(password, pw_len, u, 32);
            delete u;
            u = u2;
            for (let i <int> = 0; i < 32; i++) {
                let x <int> = cast<int>(byte_at(t, i)) ^ cast<int>(byte_at(u, i));
                t[i] = cast<char>(x);
            }
        }
        delete u;
        let off <int> = (b - 1) * 32;
        let take <int> = 32;
        if (off + take > dk_len) { take = dk_len - off; }
        for (let i <int> = 0; i < take; i++) { dk[off + i] = t[i]; }
        delete t;
    }
    dk[dk_len] = cast<char>(0);
    return dk;
}

priv fun auth_hex_digit(v: uint) <char> {
    if (v < cast<uint>(10)) {
        return cast<char>(cast<int>('0') + cast<int>(v));
    }
    return cast<char>(cast<int>('a') + cast<int>(v) - 10);
}

// --- password hashing (PBKDF2-HMAC-SHA256, supported default) ---
//
// Stored format: $pbkdf2-sha256$<iterations>$<salt b64url>$<hash b64url>.
// The default uses 600,000 iterations. Explicit legacy policy supports older
// records and migration; deployments should benchmark their work budget.
#[export]
pub struct PasswordPolicy {
    pub:
        hash_iterations <int>,
        min_verify_iterations <int>,
        max_verify_iterations <int>,
}

#[export]
pub fun password_policy_default() <PasswordPolicy> {
    return PasswordPolicy{hash_iterations: 600000, min_verify_iterations: 1, max_verify_iterations: 1000000};
}

#[export]
pub fun password_policy_legacy() <PasswordPolicy> {
    return PasswordPolicy{hash_iterations: 10000, min_verify_iterations: 1, max_verify_iterations: 1000000};
}

priv fun password_policy_valid(policy: PasswordPolicy) <bool> {
    return policy.min_verify_iterations > 0
        && policy.hash_iterations >= policy.min_verify_iterations
        && policy.hash_iterations <= policy.max_verify_iterations
        && policy.max_verify_iterations <= 1000000;
}

// Diagnostic/ interop entry point: PBKDF2-HMAC-SHA256 as lowercase hex.
// salt_b64 is base64url (the same encoding password_hash stores).
#[export]
pub fun auth_pbkdf2_hex(password: string, salt_b64: string, iterations: int) <string> {
    blame iterations > 0, "auth_pbkdf2_hex: iterations must be positive";
    let pw <[char]> = to_chars(password);
    let pw_len <int> = pw.length - 1;
    let salt <AuthBytes> = auth_b64url_decode(salt_b64);
    blame salt.len > 0, "auth_pbkdf2_hex: bad salt encoding";
    let dk <[char]> = pbkdf2(pw, pw_len, salt.data, salt.len, iterations, 32);
    delete pw;
    delete salt.data;
    let out <[char]> = new [char, 65]{};
    for (let i <int> = 0; i < 32; i++) {
        let b <uint> = byte_at(dk, i);
        out[i * 2] = auth_hex_digit(b >> cast<uint>(4));
        out[i * 2 + 1] = auth_hex_digit(b % cast<uint>(16));
    }
    out[64] = cast<char>(0);
    let s <string> = from_chars(out, 0, 64);
    delete out;
    delete dk;
    return s;
}

#[export]
pub fun password_hash(password: string) <string> {
    return password_hash_with_policy(password, password_policy_default());
}

// Owned hash on success, empty literal for invalid policy/input.
#[export]
pub fun password_hash_with_policy(password: string, policy: PasswordPolicy) <string> {
    if (!password_policy_valid(policy) || len(password) > 4096) { return ""; }
    let pw <[char]> = to_chars(password);
    let pw_len <int> = pw.length - 1;
    let salt <[char]> = random_bytes(16);
    let dk <[char]> = pbkdf2(pw, pw_len, salt, 16, policy.hash_iterations, 32);
    let salt_b64 <string> = auth_b64url_encode(salt, 16);
    let hash_b64 <string> = auth_b64url_encode(dk, 32);
    delete pw;
    delete salt;
    delete dk;
    let iterations <string> = format!("{}", policy.hash_iterations);
    let prefix <string> = concat("$pbkdf2-sha256$", iterations);
    let prefix_sep <string> = concat(prefix, "$");
    let salted <string> = concat(prefix_sep, salt_b64);
    let salted_sep <string> = concat(salted, "$");
    let h <string> = concat(salted_sep, hash_b64);
    free_str(iterations);
    free_str(prefix);
    free_str(prefix_sep);
    free_str(salted);
    free_str(salted_sep);
    free_str(salt_b64);
    free_str(hash_b64);
    return h;
}

// Split "a$b$c" on a separator into exactly 3 parts; ok=false otherwise.
#[export]
pub struct AuthParts3 {
    pub:
        ok <bool>,
        a <string>,
        b <string>,
        c <string>,
}

priv fun split3(s: string, sep: char) <AuthParts3> {
    let fail <AuthParts3> = AuthParts3{ok: false, a: "", b: "", c: ""};
    let chars <[char]> = to_chars(s);
    let n <int> = chars.length - 1;
    let p1 <int> = -1;
    let p2 <int> = -1;
    for (let i <int> = 0; i < n; i++) {
        if (chars[i] == sep) {
            if (p1 < 0) { p1 = i; } else { p2 = i; break; }
        }
    }
    delete chars;
    if (p1 < 0 || p2 < 0) { return fail; }
    // Exactly 3 parts: no further separator after p2.
    let rest <string> = substr(s, p2 + 1, n - p2 - 1);
    if (find(rest, "$") >= 0) { free_str(rest); return fail; }
    return AuthParts3{ok: true, a: substr(s, 0, p1), b: substr(s, p1 + 1, p2 - p1 - 1), c: rest};
}

priv fun auth_parts_free(parts: AuthParts3) <noret> {
    if (parts.ok) {
        free_str(parts.a);
        free_str(parts.b);
        free_str(parts.c);
    }
}

// Canonical positive decimal, with a pre-multiply bound (never parse_int/blame).
priv fun password_iterations(text: string, maximum: int) <int> {
    let n <int> = len(text);
    if (n == 0 || n > 7 || maximum < 1) { return -1; }
    let chars <[char]> = to_chars(text);
    let value <int> = 0;
    let valid <bool> = chars[0] != '0';
    for (let i <int> = 0; i < n; i++) {
        let digit <int> = cast<int>(chars[i]) - cast<int>('0');
        if (digit < 0 || digit > 9) { valid = false; break; }
        if (value > maximum / 10 || (value == maximum / 10 && digit > maximum % 10)) {
            valid = false; break;
        }
        value = value * 10 + digit;
    }
    delete chars;
    if (!valid || value == 0) { return -1; }
    return value;
}

// Validate the entire record before allocating a password buffer or doing KDF work.
priv fun password_record(hash_str: string, policy: PasswordPolicy) <AuthParts3> {
    let fail <AuthParts3> = AuthParts3{ok: false, a: "", b: "", c: ""};
    if (!password_policy_valid(policy) || len(hash_str) > 96) { return fail; }
    if (!starts_with(hash_str, "$pbkdf2-sha256$")) { return fail; }
    let body <string> = substr(hash_str, 15, len(hash_str) - 15);
    let parts <AuthParts3> = split3(body, '$');
    free_str(body);
    if (!parts.ok) { return fail; }
    let iterations <int> = password_iterations(parts.a, policy.max_verify_iterations);
    if (iterations < policy.min_verify_iterations || len(parts.b) != 22 || len(parts.c) != 43) {
        auth_parts_free(parts); return fail;
    }
    let salt <AuthBytes> = auth_b64url_decode(parts.b);
    let digest <AuthBytes> = auth_b64url_decode(parts.c);
    let valid <bool> = salt.len == 16 && digest.len == 32;
    delete salt.data;
    delete digest.data;
    if (!valid) { auth_parts_free(parts); return fail; }
    return parts;
}

#[export]
pub fun password_verify(password: string, hash_str: string) <bool> {
    return password_verify_with_policy(password, hash_str, password_policy_default());
}

#[export]
pub fun password_verify_with_policy(password: string, hash_str: string, policy: PasswordPolicy) <bool> {
    if (len(password) > 4096) { return false; }
    let parts <AuthParts3> = password_record(hash_str, policy);
    if (!parts.ok) { return false; }
    let iters <int> = password_iterations(parts.a, policy.max_verify_iterations);
    let salt <AuthBytes> = auth_b64url_decode(parts.b);
    let pw <[char]> = to_chars(password);
    let dk <[char]> = pbkdf2(pw, pw.length - 1, salt.data, salt.len, iters, 32);
    delete salt.data;
    delete pw;
    let recomputed <string> = auth_b64url_encode(dk, 32);
    delete dk;
    let valid <bool> = const_time_eq(recomputed, parts.c);
    free_str(recomputed);
    auth_parts_free(parts);
    return valid;
}

// A malformed/unsupported record also needs replacement; authenticate first.
// Stronger hashes never request a downgrade.
#[export]
pub fun password_needs_rehash(hash_str: string, policy: PasswordPolicy) <bool> {
    let parts <AuthParts3> = password_record(hash_str, policy);
    if (!parts.ok) { return true; }
    let iters <int> = password_iterations(parts.a, policy.max_verify_iterations);
    auth_parts_free(parts);
    return iters < policy.hash_iterations;
}

// --- JWT (RFC 7519), HS256 only in v0.1.0 ---

#[export]
pub struct JwtResult {
    pub:
        ok <bool>,
        payload_json <string>,
        err <string>,
}

// Fixed header; HS256 is the only algorithm this module speaks. The alg
// field is still verified on decode (never accept "none").
priv fun jwt_header_b64() <string> {
    let h <[char]> = to_chars("{\"alg\":\"HS256\",\"typ\":\"JWT\"}");
    let n <int> = h.length - 1;
    let e <string> = auth_b64url_encode(h, n);
    delete h;
    return e;
}

priv fun jwt_sign(signing_input: string, secret: string) <string> {
    let kb <[char]> = to_chars(secret);
    let kl <int> = kb.length - 1;
    let mb <[char]> = to_chars(signing_input);
    let ml <int> = mb.length - 1;
    let mac <[char]> = hmac_raw(kb, kl, mb, ml);
    delete kb;
    delete mb;
    let sig <string> = auth_b64url_encode(mac, 32);
    delete mac;
    return sig;
}

// Encode claims (a JSON object string) into a compact JWT.
#[export]
pub fun jwt_encode(payload_json: string, secret: string) <string> {
    let h <string> = jwt_header_b64();
    let pb <[char]> = to_chars(payload_json);
    let pl <int> = pb.length - 1;
    let pe <string> = auth_b64url_encode(pb, pl);
    delete pb;
    let hp <string> = concat(h, ".");
    let signing_input <string> = concat(hp, pe);
    let sig <string> = jwt_sign(signing_input, secret);
    let prefix <string> = concat(signing_input, ".");
    let token <string> = concat(prefix, sig);
    free_str(h);
    free_str(hp);
    free_str(pe);
    free_str(signing_input);
    free_str(sig);
    free_str(prefix);
    return token;
}

// Split a compact JWT into its 3 parts.
priv fun jwt_split(token: string) <AuthParts3> {
    let fail <AuthParts3> = AuthParts3{ok: false, a: "", b: "", c: ""};
    let chars <[char]> = to_chars(token);
    let n <int> = chars.length - 1;
    let p1 <int> = -1;
    let p2 <int> = -1;
    for (let i <int> = 0; i < n; i++) {
        if (chars[i] == '.') {
            if (p1 < 0) { p1 = i; } else { p2 = i; break; }
        }
    }
    delete chars;
    if (p1 < 0 || p2 < 0) { return fail; }
    let tail <string> = substr(token, p2 + 1, n - p2 - 1);
    if (find(tail, ".") >= 0) { free_str(tail); return fail; }
    return AuthParts3{ok: true, a: substr(token, 0, p1), b: substr(token, p1 + 1, p2 - p1 - 1), c: tail};
}

// Verify signature and return the payload JSON. Rejects alg != HS256 by
// comparing the header segment against our fixed header (no "none", no
// algorithm confusion).
#[export]
pub fun jwt_decode(token: string, secret: string) <JwtResult> {
    let fail <JwtResult> = JwtResult{ok: false, payload_json: "", err: ""};
    if (len(token) > 65536) { fail.err = "jwt_decode: token too large"; return fail; }
    let parts <AuthParts3> = jwt_split(token);
    if (!parts.ok) {
        fail.err = "jwt_decode: not a 3-part compact JWT";
        return fail;
    }
    let header <string> = jwt_header_b64();
    let supported <bool> = equals(parts.a, header);
    free_str(header);
    if (!supported) {
        auth_parts_free(parts);
        fail.err = "jwt_decode: unsupported or unexpected alg (only HS256)";
        return fail;
    }
    let hp <string> = concat(parts.a, ".");
    let signing_input <string> = concat(hp, parts.b);
    let want <string> = jwt_sign(signing_input, secret);
    let valid <bool> = const_time_eq(parts.c, want);
    free_str(hp);
    free_str(signing_input);
    free_str(want);
    if (!valid) {
        auth_parts_free(parts);
        fail.err = "jwt_decode: bad signature";
        return fail;
    }
    let payload <AuthBytes> = auth_b64url_decode(parts.b);
    auth_parts_free(parts);
    if (payload.len < 0) {
        delete payload.data;
        fail.err = "jwt_decode: payload is not valid base64url";
        return fail;
    }
    for (let i <int> = 0; i < payload.len; i++) {
        if (payload.data[i] == cast<char>(0)) {
            delete payload.data;
            fail.err = "jwt_decode: embedded NUL in payload";
            return fail;
        }
    }
    let js <string> = from_chars(payload.data, 0, payload.len);
    delete payload.data;
    return JwtResult{ok: true, payload_json: js, err: ""};
}

// Parse without verifying. DANGEROUS — for inspection/debugging only;
// never trust claims from this path.
#[export]
pub fun jwt_decode_unverified(token: string) <JwtResult> {
    let fail <JwtResult> = JwtResult{ok: false, payload_json: "", err: ""};
    if (len(token) > 65536) { fail.err = "jwt_decode_unverified: token too large"; return fail; }
    let parts <AuthParts3> = jwt_split(token);
    if (!parts.ok) {
        fail.err = "jwt_decode_unverified: not a 3-part compact JWT";
        return fail;
    }
    let payload <AuthBytes> = auth_b64url_decode(parts.b);
    auth_parts_free(parts);
    if (payload.len < 0) {
        delete payload.data;
        fail.err = "jwt_decode_unverified: payload is not valid base64url";
        return fail;
    }
    for (let i <int> = 0; i < payload.len; i++) {
        if (payload.data[i] == cast<char>(0)) {
            delete payload.data;
            fail.err = "jwt_decode_unverified: embedded NUL in payload";
            return fail;
        }
    }
    let js <string> = from_chars(payload.data, 0, payload.len);
    delete payload.data;
    return JwtResult{ok: true, payload_json: js, err: ""};
}

// Issuer/audience are mandatory nonempty expectations. NumericDates and clocks
// must be finite, nonnegative, and no greater than 2^53-1 (fractions allowed).
#[export]
pub struct JwtPolicy {
    pub:
        issuer <string>,
        audience <string>,
        clock_skew_secs <double>,
}

priv fun jwt_time_valid(t: double) <bool> {
    return t >= cast<double>(0.0) && t <= cast<double>(9007199254740991.0);
}

priv fun jwt_audience_matches(value: &JsonValue, expected: string) <bool> {
    if (value == null) { return false; }
    if (value.kind == 3) { return equals(value.s, expected); }
    if (value.kind != 4) { return false; }
    let found <bool> = false;
    let count <int> = json_array_len(value);
    for (let i <int> = 0; i < count; i++) {
        let item <&JsonValue> = json_array_get(value, i);
        if (item.kind != 3) { return false; }
        if (equals(item.s, expected)) { found = true; }
    }
    return found;
}

priv fun jwt_claims_error(root: &JsonValue, policy: JwtPolicy, now_unix: double) <string> {
    if (root.kind != 5) { return "jwt_verify: payload must be an object"; }
    let exp <&JsonValue> = json_object_get(root, "exp");
    if (exp == null) { return "jwt_verify: exp is required"; }
    if (exp.kind != 2) { return "jwt_verify: exp must be numeric"; }
    if (!jwt_time_valid(exp.num)) { return "jwt_verify: invalid exp"; }
    if (now_unix - policy.clock_skew_secs >= exp.num) { return "jwt_verify: expired"; }
    let nbf <&JsonValue> = json_object_get(root, "nbf");
    if (nbf != null) {
        if (nbf.kind != 2) { return "jwt_verify: nbf must be numeric"; }
        if (!jwt_time_valid(nbf.num)) { return "jwt_verify: invalid nbf"; }
        if (now_unix + policy.clock_skew_secs < nbf.num) { return "jwt_verify: not yet valid"; }
        if (nbf.num >= exp.num) { return "jwt_verify: invalid validity interval"; }
    }
    let issuer <&JsonValue> = json_object_get(root, "iss");
    if (issuer == null) { return "jwt_verify: issuer is required"; }
    if (issuer.kind != 3) { return "jwt_verify: issuer must be a string"; }
    if (!equals(issuer.s, policy.issuer)) { return "jwt_verify: issuer mismatch"; }
    if (!jwt_audience_matches(json_object_get(root, "aud"), policy.audience)) {
        return "jwt_verify: audience mismatch";
    }
    return "";
}

// Signature + strict, unambiguous claims + explicit application clock/policy.
// Success payload_json is caller-owned (free_str); failure fields are literals.
#[export]
pub fun jwt_verify(token: string, secret: string, policy: JwtPolicy, now_unix: double) <JwtResult> {
    let fail <JwtResult> = JwtResult{ok: false, payload_json: "", err: "jwt_verify: invalid policy/clock/key"};
    if (len(secret) < 32 || len(secret) > 4096 || len(policy.issuer) == 0 || len(policy.audience) == 0) { return fail; }
    if (!jwt_time_valid(now_unix) || !(policy.clock_skew_secs >= cast<double>(0.0) && policy.clock_skew_secs <= cast<double>(300.0))) {
        return fail;
    }
    let verified <JwtResult> = jwt_decode(token, secret);
    if (!verified.ok) { return verified; }
    let pr <ParseResult> = json_parse_strict(verified.payload_json);
    if (!pr.ok) {
        json_free_result(&pr);
        free_str(verified.payload_json);
        fail.err = "jwt_verify: invalid or ambiguous JSON";
        return fail;
    }
    let error <string> = jwt_claims_error(pr.value, policy, now_unix);
    json_free_result(&pr);
    if (len(error) > 0) {
        free_str(verified.payload_json);
        fail.err = error;
        return fail;
    }
    return verified;
}

#[export]
pub struct JwtClaimResult {
    pub:
        ok <bool>,
        value <string>,
        err <string>,
}

// Extract one claim from verified payload JSON, stringified via finson
// (strings come back quoted — that is finson's JSON, not a bug).
#[export]
pub fun jwt_claim(payload_json: string, name: string) <JwtClaimResult> {
    let fail <JwtClaimResult> = JwtClaimResult{ok: false, value: "", err: ""};
    let pr <ParseResult> = json_parse(payload_json);
    if (!pr.ok) {
        fail.err = "jwt_claim: payload is not valid JSON";
        json_free_result(&pr);
        return fail;
    }
    // pr.value.kind == 5 is object; anything else has no named claims.
    // (Checked before json_object_get, which blames on non-objects.)
    if (pr.value.kind != 5) {
        json_free_result(&pr);
        fail.err = "jwt_claim: payload is not a JSON object";
        return fail;
    }
    let v <&JsonValue> = json_object_get(pr.value, name);
    if (v == null) {
        json_free_result(&pr);
        fail.err = "jwt_claim: claim not present";
        return fail;
    }
    let s <string> = json_stringify(v);
    json_free_result(&pr);
    return JwtClaimResult{ok: true, value: s, err: ""};
}

// Numeric "exp" claim as a double; -1 when missing/invalid. Compared in
// double space: finc cannot lower float->int casts (backend limit 5).
#[export]
pub fun jwt_exp(payload_json: string) <double> {
    let pr <ParseResult> = json_parse(payload_json);
    if (!pr.ok) {
        json_free_result(&pr);
        return cast<double>(-1.0);
    }
    // finson kind codes: 0 null, 1 bool, 2 number, 3 string, 4 array, 5 object.
    // Kind checked before json_object_get, which blames on non-objects.
    if (pr.value.kind != 5) {
        json_free_result(&pr);
        return cast<double>(-1.0);
    }
    let v <&JsonValue> = json_object_get(pr.value, "exp");
    if (v == null || v.kind != 2) {
        json_free_result(&pr);
        return cast<double>(-1.0);
    }
    let e <double> = v.num;
    json_free_result(&pr);
    return e;
}

#[export]
pub fun jwt_is_expired(payload_json: string, now_unix: double) <bool> {
    let e <double> = jwt_exp(payload_json);
    if (!jwt_time_valid(e) || !jwt_time_valid(now_unix)) { return true; }
    return e <= now_unix;
}

// --- session store (in-memory) ---
//
// Parallel collections (backend limit 3: no Collection<StructType>):
// tokens[i] belongs to user_ids[i] and expires[i].

#[export]
pub struct SessionStore {
    pub:
        tokens <&Collection<string>>,
        user_ids <&Collection<string>>,
        expires <&Collection<long>>,
}

#[export]
pub fun session_store_new() <&SessionStore> {
    let s <&SessionStore> = new SessionStore{
        tokens: new Collection::<string>{},
        user_ids: new Collection::<string>{},
        expires: new Collection::<long>{}
    };
    return s;
}

#[export]
pub fun session_free(store: &SessionStore) <noret> {
    delete store.tokens;
    delete store.user_ids;
    delete store.expires;
    delete store;
}

// Create a session for user_id living ttl_secs seconds. Returns the token
// (a 64-hex-char random string) or "" on internal error.
#[export]
pub fun session_create(store: &SessionStore, user_id: string, ttl_secs: long) <string> {
    return session_create_at(store, user_id, ttl_secs, now());
}

#[export]
pub fun session_create_at(store: &SessionStore, user_id: string, ttl_secs: long, now_unix: long) <string> {
    // Bound addition before computing the deadline; bad inputs are recoverable.
    if (ttl_secs <= 0 || now_unix < 0 || now_unix > cast<long>(9223372036854775807) - ttl_secs) { return ""; }
    let token <string> = random_hex(32);
    store.tokens.push(token);
    store.user_ids.push(user_id);
    store.expires.push(now_unix + ttl_secs);
    return token;
}

priv fun session_index(store: &SessionStore, token: string) <int> {
    if (len(token) != 64) { return -1; }
    for (let i <int> = 0; i < store.tokens.len(); i++) {
        if (const_time_eq(store.tokens.get(i), token)) { return i; }
    }
    return -1;
}

// Look up the user_id for a token; "" when unknown or expired. Expired
// entries are left for session_sweep.
#[export]
pub fun session_get(store: &SessionStore, token: string) <string> {
    return session_get_at(store, token, now());
}

#[export]
pub fun session_get_at(store: &SessionStore, token: string, now_unix: long) <string> {
    let idx <int> = session_index(store, token);
    if (idx < 0 || now_unix < 0) { return ""; }
    if (now_unix >= store.expires.get(idx)) { return ""; }
    return store.user_ids.get(idx);
}

// Destroy a session; false when the token was unknown.
#[export]
pub fun session_destroy(store: &SessionStore, token: string) <bool> {
    let idx <int> = session_index(store, token);
    if (idx < 0) { return false; }
    let last <int> = store.tokens.len() - 1;
    // Swap-remove to keep the parallel arrays aligned.
    store.tokens.set(idx, store.tokens.get(last));
    store.user_ids.set(idx, store.user_ids.get(last));
    store.expires.set(idx, store.expires.get(last));
    store.tokens.pop_last();
    store.user_ids.pop_last();
    store.expires.pop_last();
    return true;
}

// Drop expired sessions. Returns how many were removed.
#[export]
pub fun session_sweep(store: &SessionStore) <int> {
    return session_sweep_at(store, now());
}

#[export]
pub fun session_sweep_at(store: &SessionStore, now_unix: long) <int> {
    if (now_unix < 0) { return 0; }
    let removed <int> = 0;
    let i <int> = 0;
    while (i < store.tokens.len()) {
        if (now_unix >= store.expires.get(i)) {
            session_destroy(store, store.tokens.get(i));
            removed = removed + 1;
        } else {
            i = i + 1;
        }
    }
    return removed;
}

// --- CSRF tokens ---

// A fresh CSRF token: 64 hex chars from the CSPRNG. Store per session and
// compare submissions with csrf_check.
#[export]
pub fun csrf_token() <string> {
    return random_hex(32);
}

priv fun csrf_canonical(token: string) <bool> {
    if (token == null) { return false; }
    if (len(token) != 64) { return false; }
    let chars <[char]> = to_chars(token);
    let valid <bool> = true;
    for (let i <int> = 0; i < 64; i++) {
        let c <char> = chars[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { valid = false; }
    }
    delete chars;
    return valid;
}

// Fail closed on absent/malformed tokens; compare canonical tokens in constant time.
#[export]
pub fun csrf_check(a: string, b: string) <bool> {
    if (!csrf_canonical(a) || !csrf_canonical(b)) { return false; }
    return const_time_eq(a, b);
}

}
